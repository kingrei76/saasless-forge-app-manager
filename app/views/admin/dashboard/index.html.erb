<h2 class="text-2xl font-bold mb-6">Dashboard</h2>

<div class="flex flex-wrap items-center gap-2 mb-4">
  <%= link_to admin_root_path(month: @prev_month.strftime("%Y-%m")),
        class: "btn btn-sm btn-outline", "aria-label": "Previous month" do %>
    <i class="fas fa-chevron-left"></i>
  <% end %>
  <span class="font-semibold min-w-[10rem] text-center"><%= @selected_month.strftime("%B %Y") %></span>
  <%= link_to admin_root_path(month: @next_month.strftime("%Y-%m")),
        class: "btn btn-sm btn-outline", "aria-label": "Next month" do %>
    <i class="fas fa-chevron-right"></i>
  <% end %>
  <% if @selected_month != @current_month %>
    <%= link_to "This month", admin_root_path, class: "btn btn-sm btn-ghost" %>
  <% end %>
  <%= form_with url: admin_root_path, method: :get, local: true, class: "flex items-center gap-1 ml-2" do |f| %>
    <%= f.month_field :month, value: @selected_month.strftime("%Y-%m"),
          class: "input input-sm input-bordered",
          onchange: "this.form.requestSubmit()" %>
  <% end %>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
  <div class="stat bg-base-100 rounded-box shadow">
    <div class="stat-figure text-primary">
      <i class="fas fa-rocket text-2xl"></i>
    </div>
    <div class="stat-title">Apps</div>
    <div class="stat-value text-primary"><%= @app_count %></div>
    <div class="stat-desc"><%= @app_type_counts.fetch("client_app", 0) %> client, <%= @app_type_counts.fetch("shared_microservice", 0) %> shared, <%= @app_type_counts.fetch("internal_tool", 0) %> internal</div>
  </div>

  <div class="stat bg-base-100 rounded-box shadow">
    <div class="stat-figure text-secondary">
      <i class="fas fa-users text-2xl"></i>
    </div>
    <div class="stat-title">Clients</div>
    <div class="stat-value text-secondary"><%= @client_count %></div>
  </div>

  <div class="stat bg-base-100 rounded-box shadow">
    <div class="stat-figure text-accent">
      <i class="fas fa-dollar-sign text-2xl"></i>
    </div>
    <div class="stat-title">Cost — <%= @selected_month.strftime("%b %Y") %></div>
    <div class="stat-value text-accent"><%= number_to_currency(@monthly_cost) %></div>
  </div>

  <div class="stat bg-base-100 rounded-box shadow">
    <div class="stat-figure text-success">
      <i class="fas fa-chart-line text-2xl"></i>
    </div>
    <div class="stat-title">Revenue — <%= @selected_month.strftime("%b %Y") %></div>
    <div class="stat-value text-success"><%= number_to_currency(@monthly_revenue) %></div>
  </div>
</div>

<% if defined?(Agent) && respond_to?(:admin_agents_path) %>
<!-- AI Agent Stats -->
<div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
  <div class="stat bg-base-100 rounded-box shadow">
    <div class="stat-figure text-info">
      <i class="fas fa-robot text-2xl"></i>
    </div>
    <div class="stat-title">Active Agents</div>
    <div class="stat-value text-info"><%= @agent_count %></div>
    <div class="stat-desc"><%= link_to "View agents", admin_agents_path, class: "link" %></div>
  </div>
  <div class="stat bg-base-100 rounded-box shadow">
    <div class="stat-figure text-warning">
      <i class="fas fa-play-circle text-2xl"></i>
    </div>
    <div class="stat-title">Executions Today</div>
    <div class="stat-value text-warning"><%= @agent_executions_today %></div>
    <div class="stat-desc"><%= link_to "View executions", admin_agent_executions_path, class: "link" %></div>
  </div>
  <div class="stat bg-base-100 rounded-box shadow">
    <div class="stat-figure text-error">
      <i class="fas fa-bell text-2xl"></i>
    </div>
    <div class="stat-title">Open Alerts</div>
    <div class="stat-value text-error"><%= @agent_open_alerts %></div>
    <div class="stat-desc"><%= link_to "View alerts", admin_agent_alerts_path, class: "link" %></div>
  </div>
</div>
<% end %>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
  <div class="card bg-base-100 shadow">
    <div class="card-body">
      <h3 class="card-title">Quick Actions</h3>
      <div class="flex flex-wrap gap-2 mt-2">
        <%= link_to admin_apps_path, class: "btn btn-outline btn-sm" do %>
          <i class="fas fa-rocket mr-1"></i> View Apps
        <% end %>
        <%= link_to new_admin_client_path, class: "btn btn-outline btn-sm" do %>
          <i class="fas fa-user-plus mr-1"></i> Add Client
        <% end %>
        <%= link_to new_admin_cost_entry_path, class: "btn btn-outline btn-sm" do %>
          <i class="fas fa-plus mr-1"></i> Add Cost Entry
        <% end %>
        <%= link_to admin_projects_path, class: "btn btn-outline btn-sm" do %>
          <i class="fas fa-folder-open mr-1"></i> Projects
        <% end %>
        <%= link_to new_admin_invoice_path, class: "btn btn-outline btn-sm" do %>
          <i class="fas fa-file-invoice mr-1"></i> New Usage Invoice
        <% end %>
      </div>
    </div>
  </div>

  <div class="card bg-base-100 shadow">
    <div class="card-body">
      <h3 class="card-title">System Info</h3>
      <div class="overflow-x-auto">
        <table class="table table-sm">
          <tbody>
            <tr><td class="font-medium">Users</td><td><%= @user_count %></td></tr>
            <tr><td class="font-medium">Rails</td><td><%= Rails.version %></td></tr>
            <tr><td class="font-medium">Ruby</td><td><%= RUBY_VERSION %></td></tr>
            <tr><td class="font-medium">Environment</td><td><%= Rails.env %></td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
