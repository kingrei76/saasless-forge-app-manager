<div class="flex justify-between items-center mb-6">
  <div>
    <h2 class="text-2xl font-bold">Infrastructure</h2>
    <p class="text-sm opacity-60">Manage service providers, hosting, and API integrations</p>
  </div>
</div>

<%# Getting Started Guide — shown when no providers exist %>
<% if @service_providers.empty? %>
  <div class="alert alert-info mb-6 shadow-sm">
    <i class="fas fa-info-circle text-lg"></i>
    <div>
      <h4 class="font-bold">Getting Started with the Service Gateway</h4>
      <ol class="list-decimal list-inside text-sm mt-1 space-y-1">
        <li><strong>Add a provider</strong> — click "Service Providers" then "Add Provider" to register an AI or third-party API (e.g. xAI/Grok, OpenAI).</li>
        <li><strong>Connect apps</strong> — go to any App detail page and link providers under "Connected Services". Set optional budget limits.</li>
        <li><strong>Generate a gateway key</strong> — on the App page, generate a Gateway API Key. Your app uses this single key to call any connected provider.</li>
        <li><strong>Track usage</strong> — the "Usage & Costs" tab shows token consumption, API call counts, and estimated costs per app and provider.</li>
      </ol>
    </div>
  </div>
<% end %>

<%# Combined Stats Cards %>
<%= render "stats_cards" %>

<%# Tab Navigation %>
<div data-controller="toggle" class="mt-6">
  <div class="tabs tabs-boxed bg-base-100 p-1 mb-6">
    <a href="#"
       data-toggle-target="tab"
       data-tab="service_providers"
       data-action="click->toggle#show"
       class="tab <%= @tab == 'service_providers' ? 'tab-active' : '' %>">
      <i class="fas fa-plug mr-2"></i> Service Providers
    </a>
    <a href="#"
       data-toggle-target="tab"
       data-tab="render_services"
       data-action="click->toggle#show"
       class="tab <%= @tab == 'render_services' ? 'tab-active' : '' %>">
      <i class="fas fa-cloud mr-2"></i> Render Services
    </a>
    <a href="#"
       data-toggle-target="tab"
       data-tab="usage"
       data-action="click->toggle#show"
       class="tab <%= @tab == 'usage' ? 'tab-active' : '' %>">
      <i class="fas fa-chart-line mr-2"></i> Usage & Costs
    </a>
  </div>

  <%# Service Providers Tab %>
  <div data-toggle-target="panel" data-panel="service_providers" class="<%= @tab != 'service_providers' ? 'hidden' : '' %>">
    <%= render "service_providers_tab" %>
  </div>

  <%# Render Services Tab %>
  <div data-toggle-target="panel" data-panel="render_services" class="<%= @tab != 'render_services' ? 'hidden' : '' %>">
    <%= render "render_services_tab" %>
  </div>

  <%# Usage & Costs Tab %>
  <div data-toggle-target="panel" data-panel="usage" class="<%= @tab != 'usage' ? 'hidden' : '' %>">
    <%= render "usage_tab" %>
  </div>
</div>
