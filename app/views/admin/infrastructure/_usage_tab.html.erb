<%# Usage & Costs Tab Header %>
<div class="flex justify-between items-center mb-4">
  <div>
    <h3 class="text-lg font-semibold">Usage & Costs</h3>
    <p class="text-sm opacity-60">Track API usage, costs, and tokens across all service providers</p>
  </div>
</div>

<%# Bulk Assign Unassigned Logs %>
<% unassigned_count = ApiUsageLog.without_app.count %>
<% if unassigned_count > 0 %>
  <div class="alert alert-warning mb-6">
    <i class="fas fa-exclamation-triangle"></i>
    <span><strong><%= unassigned_count %></strong> API usage logs are not assigned to any app.</span>
    <%= form_tag assign_api_logs_admin_infrastructure_path, method: :post, class: "flex items-center gap-2 ml-auto" do %>
      <%= select_tag :app_id,
          options_from_collection_for_select(App.order(:name), :id, :name),
          prompt: "Select app...",
          class: "select select-bordered select-sm w-48",
          required: true %>
      <button type="submit" class="btn btn-sm btn-primary">
        <i class="fas fa-link"></i> Assign All
      </button>
    <% end %>
  </div>
<% end %>

<%# Filters %>
<div class="bg-base-100 rounded-box shadow p-4 mb-6">
  <%= form_tag admin_infrastructure_path, method: :get, class: "flex flex-wrap gap-4 items-end" do %>
    <%= hidden_field_tag :tab, "usage" %>

    <div class="form-control">
      <label class="label"><span class="label-text">Time Period</span></label>
      <%= select_tag :period,
          options_for_select([
            ["This Month", "this_month"],
            ["Last Month", "last_month"],
            ["All Time", "all_time"]
          ], @period),
          class: "select select-bordered select-sm w-40" %>
    </div>

    <div class="form-control">
      <label class="label"><span class="label-text">Provider</span></label>
      <%= select_tag :provider_id,
          options_from_collection_for_select(@providers_with_usage, :id, :name, params[:provider_id]),
          include_blank: "All Providers",
          class: "select select-bordered select-sm w-48" %>
    </div>

    <div class="form-control">
      <label class="label"><span class="label-text">App</span></label>
      <%= select_tag :app_id,
          options_from_collection_for_select(@apps_with_api_usage, :id, :name, params[:app_id]),
          include_blank: "All Apps",
          class: "select select-bordered select-sm w-48" %>
    </div>

    <button type="submit" class="btn btn-sm btn-primary">Apply</button>

    <% if params[:app_id].present? || params[:provider_id].present? %>
      <%= link_to admin_infrastructure_path(tab: "usage", period: @period), class: "btn btn-sm btn-ghost" do %>
        <i class="fas fa-times"></i> Clear Filters
      <% end %>
    <% end %>
  <% end %>
</div>

<%# API Usage Stats Cards %>
<div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
  <div class="card bg-base-100 shadow">
    <div class="card-body py-4">
      <div class="text-sm opacity-60">Total Cost (<%= period_label(@period) %>)</div>
      <div class="text-2xl font-bold text-primary"><%= number_to_currency(@api_total_cost) %></div>
    </div>
  </div>
  <div class="card bg-base-100 shadow">
    <div class="card-body py-4">
      <div class="text-sm opacity-60">API Calls</div>
      <div class="text-2xl font-bold"><%= number_with_delimiter(@api_total_calls) %></div>
    </div>
  </div>
  <div class="card bg-base-100 shadow">
    <div class="card-body py-4">
      <div class="text-sm opacity-60">Input Tokens</div>
      <div class="text-2xl font-bold text-info"><%= format_tokens(@api_input_tokens) %></div>
    </div>
  </div>
  <div class="card bg-base-100 shadow">
    <div class="card-body py-4">
      <div class="text-sm opacity-60">Output Tokens</div>
      <div class="text-2xl font-bold text-secondary"><%= format_tokens(@api_output_tokens) %></div>
    </div>
  </div>
</div>

<%# Usage by Operation Table %>
<div class="overflow-x-auto bg-base-100 rounded-box shadow">
  <table class="table">
    <thead>
      <tr>
        <th>Operation</th>
        <th class="text-right">Calls</th>
        <th class="text-right">Input Tokens</th>
        <th class="text-right">Output Tokens</th>
        <th class="text-right">Total Tokens</th>
        <th class="text-right">Cost</th>
      </tr>
    </thead>
    <tbody>
      <% @api_by_operation.each do |row| %>
        <tr>
          <td>
            <div class="flex items-center gap-2">
              <i class="fas fa-cog text-base-content/50"></i>
              <span class="font-medium"><%= operation_label(row.operation) %></span>
            </div>
          </td>
          <td class="text-right"><%= number_with_delimiter(row.call_count) %></td>
          <td class="text-right text-info"><%= format_tokens(row.total_input_tokens) %></td>
          <td class="text-right text-secondary"><%= format_tokens(row.total_output_tokens) %></td>
          <td class="text-right font-mono">
            <%= format_tokens((row.total_input_tokens || 0) + (row.total_output_tokens || 0)) %>
          </td>
          <td class="text-right">
            <span class="font-semibold"><%= number_to_currency(row.total_cost || 0) %></span>
          </td>
        </tr>
      <% end %>
    </tbody>
    <tfoot>
      <tr class="font-semibold bg-base-200">
        <td>Total</td>
        <td class="text-right"><%= number_with_delimiter(@api_total_calls) %></td>
        <td class="text-right text-info"><%= format_tokens(@api_input_tokens) %></td>
        <td class="text-right text-secondary"><%= format_tokens(@api_output_tokens) %></td>
        <td class="text-right font-mono"><%= format_tokens(@api_total_tokens) %></td>
        <td class="text-right text-primary"><%= number_to_currency(@api_total_cost) %></td>
      </tr>
    </tfoot>
  </table>

  <% if @api_by_operation.empty? %>
    <div class="p-8 text-center opacity-60">
      <i class="fas fa-chart-line text-4xl mb-2"></i>
      <p>No API usage recorded for <%= period_label(@period).downcase %>.</p>
    </div>
  <% end %>
</div>

<%# Usage by App Table %>
<% if @api_by_app.any? %>
  <div class="overflow-x-auto bg-base-100 rounded-box shadow mt-6">
    <div class="p-4 border-b">
      <h4 class="font-semibold">Usage by App</h4>
    </div>
    <table class="table">
      <thead>
        <tr>
          <th>App</th>
          <th class="text-right">Calls</th>
          <th class="text-right">Cost</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @api_by_app.each do |row| %>
          <tr>
            <td>
              <%= link_to row.app_name, admin_app_path(row.app_id), class: "link link-primary" %>
            </td>
            <td class="text-right"><%= number_with_delimiter(row.call_count) %></td>
            <td class="text-right font-semibold"><%= number_to_currency(row.total_cost) %></td>
            <td>
              <%= link_to admin_infrastructure_path(tab: "usage", app_id: row.app_id, period: @period), class: "btn btn-ghost btn-xs" do %>
                <i class="fas fa-filter"></i> Filter
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>

<%# Cost Breakdown Chart %>
<% if @api_by_operation.any? %>
  <div class="card bg-base-100 shadow mt-6">
    <div class="card-body">
      <h4 class="card-title text-base">Cost Breakdown by Operation</h4>
      <div class="h-64">
        <canvas id="api-cost-chart" data-controller="chart" data-chart-type-value="doughnut" data-chart-data-value='<%= {
          labels: @api_by_operation.map { |r| operation_label(r.operation) },
          datasets: [{
            data: @api_by_operation.map { |r| r.total_cost.to_f.round(4) },
            backgroundColor: ["#4f46e5", "#0891b2", "#059669", "#d97706", "#dc2626", "#7c3aed"]
          }]
        }.to_json %>'></canvas>
      </div>
    </div>
  </div>
<% end %>
