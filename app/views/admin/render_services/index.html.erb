<div class="flex justify-between items-center mb-6">
  <div>
    <h2 class="text-2xl font-bold">Render Services</h2>
    <p class="text-sm opacity-60">Manage Render service associations with apps</p>
  </div>
  <div class="flex gap-2">
    <%= button_to sync_admin_render_services_path, method: :post, class: "btn btn-outline btn-sm" do %>
      <i class="fas fa-sync mr-1"></i> Sync from Render
    <% end %>
  </div>
</div>

<%# Stats Cards %>
<div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
  <div class="card bg-base-100 shadow">
    <div class="card-body py-4">
      <div class="text-sm opacity-60">Total Services</div>
      <div class="text-2xl font-bold"><%= @total_services %></div>
    </div>
  </div>
  <div class="card bg-base-100 shadow">
    <div class="card-body py-4">
      <div class="text-sm opacity-60">Linked</div>
      <div class="text-2xl font-bold text-success"><%= @linked_count %></div>
    </div>
  </div>
  <div class="card bg-base-100 shadow">
    <div class="card-body py-4">
      <div class="text-sm opacity-60">Unlinked</div>
      <div class="text-2xl font-bold text-warning"><%= @unlinked_count %></div>
    </div>
  </div>
  <div class="card bg-base-100 shadow">
    <div class="card-body py-4">
      <div class="text-sm opacity-60">Est. Monthly Cost</div>
      <div class="text-2xl font-bold text-primary"><%= number_to_currency(@total_monthly_cost) %></div>
    </div>
  </div>
</div>

<%# Filters %>
<div class="bg-base-100 rounded-box shadow p-4 mb-6">
  <%= form_tag admin_render_services_path, method: :get, class: "flex flex-wrap gap-4 items-end" do %>
    <div class="form-control">
      <label class="label"><span class="label-text">GitHub Account</span></label>
      <%= select_tag :github_account_id,
          options_from_collection_for_select(@github_accounts, :id, :display_name, params[:github_account_id]),
          include_blank: "All Accounts",
          class: "select select-bordered select-sm w-40" %>
    </div>

    <div class="form-control">
      <label class="label"><span class="label-text">Service Type</span></label>
      <%= select_tag :service_type,
          options_for_select([["All Types", ""]] + @service_types.map { |t| [RenderService::SERVICE_TYPE_LABELS[t] || t.titleize, t] }, params[:service_type]),
          class: "select select-bordered select-sm w-40" %>
    </div>

    <div class="form-control">
      <label class="label"><span class="label-text">Workspace</span></label>
      <%= select_tag :owner_id,
          options_from_collection_for_select(@workspaces, :render_owner_id, :name, params[:owner_id]),
          include_blank: "All Workspaces",
          class: "select select-bordered select-sm w-48" %>
    </div>

    <div class="form-control">
      <label class="label"><span class="label-text">Status</span></label>
      <%= select_tag :linked,
          options_for_select([["All", ""], ["Linked", "true"], ["Unlinked", "false"]], params[:linked]),
          class: "select select-bordered select-sm w-32" %>
    </div>

    <button type="submit" class="btn btn-sm btn-primary">Filter</button>
    <%= link_to "Clear", admin_render_services_path, class: "btn btn-sm btn-ghost" %>
  <% end %>
</div>

<%# Services Table %>
<div class="overflow-x-auto bg-base-100 rounded-box shadow">
  <table class="table">
    <thead>
      <tr>
        <th>Service</th>
        <th>Type</th>
        <th>Plan</th>
        <th class="text-right">Monthly Cost</th>
        <th>Linked App</th>
        <th>Workspace</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody id="render-services-table">
      <% @render_services.each do |service| %>
        <%= render partial: "admin/render_services/service_row", locals: { service: service, apps: @apps } %>
      <% end %>
    </tbody>
  </table>

  <% if @render_services.empty? %>
    <div class="p-8 text-center opacity-60">
      <i class="fas fa-cloud text-4xl mb-2"></i>
      <p>No Render services found. Click "Sync from Render" to fetch services.</p>
    </div>
  <% end %>
</div>
