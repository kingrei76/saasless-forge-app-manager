<%= form_with(model: [:admin, project], class: "space-y-4") do |f| %>
  <% if project.errors.any? %>
    <div class="alert alert-error">
      <ul><% project.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %></ul>
    </div>
  <% end %>

  <div class="form-control">
    <%= f.label :title, class: "label" %>
    <%= f.text_field :title, class: "input input-bordered w-full" %>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div class="form-control">
      <%= f.label :client_id, "Client", class: "label" %>
      <%= f.select :client_id, options_from_collection_for_select(@clients, :id, :name, project.client_id), { prompt: "Select client..." }, class: "select select-bordered w-full" %>
    </div>

    <div class="form-control">
      <%= f.label :assignee_id, "Assignee", class: "label" %>
      <%= f.select :assignee_id, options_from_collection_for_select(@users, :id, :name, project.assignee_id), { prompt: "Unassigned" }, class: "select select-bordered w-full" %>
    </div>
  </div>

  <div class="form-control">
    <%= f.label :description, class: "label" %>
    <%= f.text_area :description, class: "textarea textarea-bordered w-full", rows: 6 %>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div class="form-control">
      <%= f.label :status, class: "label" %>
      <%= f.select :status, [["Active", "active"], ["On Hold", "on_hold"], ["Completed", "completed"], ["Cancelled", "cancelled"]], { selected: project.status }, class: "select select-bordered w-full" %>
    </div>

    <div class="form-control">
      <%= f.label :stage, class: "label" %>
      <%= f.select :stage, Project::STAGES.map { |s| [Project::STAGE_LABELS[s], s] }, { selected: project.stage, include_blank: "No stage" }, class: "select select-bordered w-full" %>
    </div>
  </div>

  <div class="form-control">
    <%= f.label :estimated_hours, class: "label" %>
    <%= f.number_field :estimated_hours, class: "input input-bordered w-full", step: 0.5, min: 0, placeholder: "e.g., 40" %>
  </div>

  <div class="divider">Key Dates</div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
    <div class="form-control">
      <%= f.label :development_due_date, "Development Due Date", class: "label" %>
      <%= f.date_field :development_due_date, class: "input input-bordered w-full" %>
    </div>

    <div class="form-control">
      <%= f.label :go_live_date, "Go Live Date", class: "label" %>
      <%= f.date_field :go_live_date, class: "input input-bordered w-full" %>
    </div>

    <div class="form-control">
      <%= f.label :adoption_due_date, "Adoption Due Date", class: "label" %>
      <%= f.date_field :adoption_due_date, class: "input input-bordered w-full" %>
    </div>
  </div>

  <div class="flex gap-2">
    <%= f.submit class: "btn btn-primary" %>
    <%= link_to "Cancel", project.persisted? ? admin_project_path(project) : admin_projects_path, class: "btn btn-ghost" %>
  </div>
<% end %>
