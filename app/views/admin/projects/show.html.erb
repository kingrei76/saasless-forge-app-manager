<div class="flex justify-between items-center mb-6">
  <div>
    <h2 class="text-2xl font-bold"><%= @project.title %></h2>
    <p class="text-sm opacity-60">
      <%= link_to @project.client.name, admin_client_path(@project.client), class: "link link-hover" %>
      <% if @project.assignee %>
        <span class="mx-2">|</span>
        <i class="fas fa-user mr-1"></i> <%= @project.assignee.name || @project.assignee.email %>
      <% end %>
    </p>
  </div>
  <div class="flex gap-2">
    <%= link_to new_admin_project_time_entry_path(@project), class: "btn btn-primary btn-sm" do %>
      <i class="fas fa-clock mr-1"></i> Log Time
    <% end %>
    <%= link_to edit_admin_project_path(@project), class: "btn btn-outline btn-sm" do %>
      <i class="fas fa-edit mr-1"></i> Edit
    <% end %>
  </div>
</div>

<!-- Stage Stepper -->
<% if @project.stage.present? %>
  <div class="card bg-base-100 shadow mb-6">
    <div class="card-body py-4">
      <div class="flex items-center justify-between mb-4">
        <h3 class="font-medium">Project Stage</h3>
        <div class="flex gap-2">
          <% if @project.can_advance_stage? %>
            <%= button_to advance_stage_admin_project_path(@project),
                method: :post,
                class: "btn btn-primary btn-sm",
                data: { turbo_confirm: "Advance to #{Project::STAGE_LABELS[@project.next_stage]}?" } do %>
              <i class="fas fa-arrow-right mr-1"></i> Advance to <%= Project::STAGE_LABELS[@project.next_stage] %>
            <% end %>
          <% elsif @project.can_complete? %>
            <%= button_to complete_admin_project_path(@project),
                method: :post,
                class: "btn btn-success btn-sm",
                data: { turbo_confirm: "Complete this project? This will create the final invoice." } do %>
              <i class="fas fa-check mr-1"></i> Complete Project
            <% end %>
          <% end %>
        </div>
      </div>

      <ul class="steps steps-horizontal w-full">
        <% Project::STAGES.each_with_index do |stage, index| %>
          <% step_class = if stage == @project.stage
                            "step step-primary"
                          elsif index < @project.stage_index
                            "step step-primary"
                          else
                            "step"
                          end %>
          <li class="<%= step_class %>"><%= Project::STAGE_LABELS[stage] %></li>
        <% end %>
      </ul>
    </div>
  </div>
<% end %>

<!-- Stats Row -->
<div class="grid grid-cols-2 md:grid-cols-5 gap-4 mb-6">
  <div class="stat bg-base-100 rounded-box shadow">
    <div class="stat-title">Status</div>
    <% badge_class = { "active" => "badge-success", "on_hold" => "badge-warning", "completed" => "badge-info", "cancelled" => "badge-error" }[@project.status] %>
    <div class="stat-value text-lg"><span class="badge <%= badge_class %>"><%= @project.status.titleize %></span></div>
  </div>
  <div class="stat bg-base-100 rounded-box shadow">
    <div class="stat-title">Estimated Hours</div>
    <div class="stat-value text-lg"><%= @project.estimated_hours || "—" %></div>
  </div>
  <div class="stat bg-base-100 rounded-box shadow">
    <div class="stat-title">Actual Hours</div>
    <div class="stat-value text-lg"><%= @project.actual_hours %></div>
    <% if @project.hours_variance_percentage %>
      <div class="stat-desc">
        <% variance = @project.hours_variance_percentage %>
        <% if variance > 0 %>
          <span class="text-error">+<%= variance %>% over</span>
        <% elsif variance < 0 %>
          <span class="text-success"><%= variance.abs %>% under</span>
        <% else %>
          <span class="text-success">On target</span>
        <% end %>
      </div>
    <% end %>
  </div>
  <div class="stat bg-base-100 rounded-box shadow">
    <div class="stat-title">Invoices</div>
    <div class="stat-value text-lg"><%= @invoices.size %></div>
  </div>
  <div class="stat bg-base-100 rounded-box shadow">
    <div class="stat-title">Created</div>
    <div class="stat-value text-sm"><%= local_time(@project.created_at) %></div>
  </div>
</div>

<!-- Due Dates -->
<% if @project.development_due_date.present? || @project.go_live_date.present? || @project.adoption_due_date.present? %>
  <div class="card bg-base-100 shadow mb-6">
    <div class="card-body py-4">
      <h3 class="font-medium mb-3">Key Dates</h3>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <% if @project.development_due_date %>
          <div class="flex items-center gap-2">
            <i class="fas fa-code text-primary"></i>
            <div>
              <div class="text-xs opacity-60">Development Due</div>
              <div class="font-medium"><%= local_time(@project.development_due_date) %></div>
            </div>
          </div>
        <% end %>
        <% if @project.go_live_date %>
          <div class="flex items-center gap-2">
            <i class="fas fa-rocket text-success"></i>
            <div>
              <div class="text-xs opacity-60">Go Live</div>
              <div class="font-medium"><%= local_time(@project.go_live_date) %></div>
            </div>
          </div>
        <% end %>
        <% if @project.adoption_due_date %>
          <div class="flex items-center gap-2">
            <i class="fas fa-users text-info"></i>
            <div>
              <div class="text-xs opacity-60">Adoption Due</div>
              <div class="font-medium"><%= local_time(@project.adoption_due_date) %></div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>

<% if @project.description.present? %>
  <div class="card bg-base-100 shadow mb-6">
    <div class="card-body">
      <h3 class="card-title text-base">Description</h3>
      <p class="whitespace-pre-wrap"><%= @project.description %></p>
    </div>
  </div>
<% end %>

<!-- Linked Apps -->
<div class="card bg-base-100 shadow mb-6">
  <div class="card-body">
    <h3 class="card-title text-base">Linked Apps</h3>

    <% if @project.has_pending_apps? %>
      <div class="alert alert-warning mb-4">
        <i class="fas fa-exclamation-triangle"></i>
        <span>This project has apps that need to be linked to existing repositories.</span>
      </div>
    <% end %>

    <% if @project_apps.any? %>
      <div class="overflow-x-auto">
        <table class="table table-sm">
          <thead>
            <tr>
              <th>App</th>
              <th>Repository</th>
              <th>Status</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @project_apps.each do |project_app| %>
              <tr class="<%= 'bg-warning/10' if project_app.pending_app? %>">
                <td class="font-medium">
                  <% if project_app.app %>
                    <%= link_to project_app.app.name, admin_app_path(project_app.app), class: "link link-primary" %>
                    <% if project_app.primary? %>
                      <span class="badge badge-primary badge-xs ml-1">Primary</span>
                    <% end %>
                  <% else %>
                    <span class="text-warning"><%= project_app.new_app_name %></span>
                    <span class="badge badge-warning badge-xs ml-1">Pending</span>
                  <% end %>
                </td>
                <td class="text-sm font-mono">
                  <% if project_app.app&.full_name %>
                    <%= link_to project_app.app.full_name, "https://github.com/#{project_app.app.full_name}", target: "_blank", class: "link link-secondary" %>
                  <% else %>
                    <span class="opacity-60">Not linked</span>
                  <% end %>
                </td>
                <td>
                  <% if project_app.app %>
                    <span class="badge badge-success badge-sm">Linked</span>
                  <% else %>
                    <span class="badge badge-warning badge-sm">Needs Mapping</span>
                  <% end %>
                </td>
                <td>
                  <% if project_app.pending_app? && @available_apps.any? %>
                    <%= form_with url: link_app_admin_project_path(@project), method: :post, class: "flex gap-2 items-center" do |f| %>
                      <%= hidden_field_tag :project_app_id, project_app.id %>
                      <%= select_tag :app_id, options_from_collection_for_select(@available_apps, :id, :name), prompt: "Select app...", class: "select select-bordered select-xs" %>
                      <%= f.submit "Link", class: "btn btn-primary btn-xs" %>
                    <% end %>
                  <% elsif project_app.app %>
                    <%= button_to unlink_app_admin_project_path(@project, project_app_id: project_app.id),
                        method: :delete,
                        class: "btn btn-ghost btn-xs text-error",
                        data: { turbo_confirm: "Remove this app from the project?" } do %>
                      <i class="fas fa-unlink"></i>
                    <% end %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="text-sm opacity-60 mb-4">No apps linked to this project yet.</p>
    <% end %>

    <% if @available_apps.any? %>
      <div class="divider text-sm">Add App</div>
      <%= form_with url: link_app_admin_project_path(@project), method: :post, class: "flex gap-2 items-end" do |f| %>
        <div class="form-control flex-1">
          <%= select_tag :app_id, options_from_collection_for_select(@available_apps, :id, :name), prompt: "Select an app...", class: "select select-bordered select-sm" %>
        </div>
        <%= f.submit "Add App", class: "btn btn-primary btn-sm" %>
      <% end %>
    <% end %>
  </div>
</div>

<!-- GitHub Commits -->
<% if @commits.any? %>
  <div class="card bg-base-100 shadow mb-6">
    <div class="card-body">
      <div class="flex justify-between items-center">
        <h3 class="card-title text-base">
          <i class="fab fa-github mr-2"></i> Recent Commits
        </h3>
        <% if @project.primary_app&.full_name %>
          <%= link_to "https://github.com/#{@project.primary_app.full_name}/commits", target: "_blank", class: "btn btn-ghost btn-sm" do %>
            View on GitHub <i class="fas fa-external-link-alt ml-1"></i>
          <% end %>
        <% end %>
      </div>
      <div class="overflow-x-auto mt-4">
        <table class="table table-sm">
          <thead>
            <tr>
              <th>Commit</th>
              <th>Message</th>
              <th>Author</th>
              <th>Date</th>
            </tr>
          </thead>
          <tbody>
            <% @commits.each do |commit| %>
              <tr>
                <td class="font-mono text-xs">
                  <%= link_to commit["sha"][0..6], commit["html_url"], target: "_blank", class: "link link-secondary" %>
                </td>
                <td class="max-w-md">
                  <span class="text-sm"><%= truncate(commit.dig("commit", "message")&.split("\n")&.first || "", length: 80) %></span>
                </td>
                <td class="text-sm">
                  <% if commit.dig("author", "avatar_url") %>
                    <div class="flex items-center gap-2">
                      <div class="avatar">
                        <div class="w-6 rounded-full">
                          <img src="<%= commit.dig("author", "avatar_url") %>" alt="<%= commit.dig("author", "login") %>" />
                        </div>
                      </div>
                      <span><%= commit.dig("author", "login") || commit.dig("commit", "author", "name") %></span>
                    </div>
                  <% else %>
                    <%= commit.dig("commit", "author", "name") %>
                  <% end %>
                </td>
                <td class="text-sm opacity-60">
                  <% commit_date = commit.dig("commit", "author", "date") %>
                  <% if commit_date %>
                    <%= time_ago_in_words(Time.parse(commit_date)) %> ago
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
<% elsif @project.has_linked_app? %>
  <div class="card bg-base-100 shadow mb-6">
    <div class="card-body">
      <h3 class="card-title text-base">
        <i class="fab fa-github mr-2"></i> Recent Commits
      </h3>
      <p class="text-sm opacity-60">Unable to fetch commits. The linked app may not have GitHub access configured.</p>
    </div>
  </div>
<% end %>

<!-- Time Tracking Summary -->
<div class="card bg-base-100 shadow mb-6">
  <div class="card-body">
    <div class="flex justify-between items-center">
      <h3 class="card-title text-base">Time Tracking</h3>
      <div class="flex gap-2">
        <%= link_to new_admin_project_time_entry_path(@project), class: "btn btn-primary btn-sm" do %>
          <i class="fas fa-plus mr-1"></i> Log Time
        <% end %>
        <%= link_to admin_project_time_entries_path(@project), class: "btn btn-ghost btn-sm" do %>
          View All
        <% end %>
      </div>
    </div>

    <!-- Hours by Category -->
    <% if @hours_by_category.any? %>
      <div class="grid grid-cols-2 md:grid-cols-5 gap-3 mt-4">
        <% @hours_by_category.each do |category, hours| %>
          <div class="stat bg-base-200 rounded-lg p-3">
            <div class="stat-title text-xs"><%= TimeEntry::WORK_CATEGORY_LABELS[category] %></div>
            <div class="stat-value text-lg"><%= hours %> hrs</div>
          </div>
        <% end %>
      </div>
    <% end %>

    <!-- Progress Bar -->
    <% if @project.estimated_hours.present? && @project.estimated_hours > 0 %>
      <div class="mt-4">
        <div class="flex justify-between text-sm mb-1">
          <span><%= @project.actual_hours %> / <%= @project.estimated_hours %> hours</span>
          <span><%= ((@project.actual_hours.to_f / @project.estimated_hours) * 100).round(0) %>%</span>
        </div>
        <progress class="progress progress-primary w-full" value="<%= @project.actual_hours %>" max="<%= @project.estimated_hours %>"></progress>
      </div>
    <% end %>

    <!-- Recent Entries -->
    <% if @time_entries.any? %>
      <div class="overflow-x-auto mt-4">
        <table class="table table-sm">
          <thead>
            <tr>
              <th>Date</th>
              <th>Hours</th>
              <th>Category</th>
              <th>Notes</th>
              <th>By</th>
            </tr>
          </thead>
          <tbody>
            <% @time_entries.each do |entry| %>
              <tr>
                <td class="font-medium"><%= local_time(entry.entry_date, "month-day") %></td>
                <td><%= entry.hours %> hrs</td>
                <td><span class="badge badge-outline badge-xs"><%= entry.work_category_label %></span></td>
                <td class="max-w-xs truncate text-sm opacity-80"><%= entry.notes %></td>
                <td class="text-sm"><%= entry.user.name || entry.user.email %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="text-sm opacity-60 mt-4">No time entries logged yet.</p>
    <% end %>
  </div>
</div>

<!-- Attachments -->
<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
  <div class="card bg-base-100 shadow">
    <div class="card-body">
      <h3 class="card-title text-base">Requirements Doc</h3>
      <% if @project.requirements_doc.attached? %>
        <p class="text-sm text-success"><i class="fas fa-check mr-1"></i> Uploaded: <%= @project.requirements_doc.filename %></p>
        <%= link_to "Download", rails_blob_path(@project.requirements_doc, disposition: "attachment"), class: "btn btn-ghost btn-sm" %>
      <% else %>
        <p class="text-sm opacity-60 mb-2">No requirements doc uploaded yet.</p>
      <% end %>
      <%= form_with(url: upload_requirements_admin_project_path(@project), method: :patch, multipart: true, class: "flex gap-2 items-end") do |f| %>
        <%= f.file_field :requirements_doc, class: "file-input file-input-bordered file-input-sm flex-1" %>
        <%= f.submit "Upload", class: "btn btn-sm btn-primary" %>
      <% end %>
    </div>
  </div>

  <div class="card bg-base-100 shadow">
    <div class="card-body">
      <h3 class="card-title text-base">Signed Contract</h3>
      <% if @project.signed_contract.attached? %>
        <p class="text-sm text-success"><i class="fas fa-check mr-1"></i> Uploaded: <%= @project.signed_contract.filename %></p>
        <%= link_to "Download", rails_blob_path(@project.signed_contract, disposition: "attachment"), class: "btn btn-ghost btn-sm" %>
      <% else %>
        <p class="text-sm opacity-60 mb-2">No signed contract uploaded yet.</p>
      <% end %>
      <%= form_with(url: upload_signed_contract_admin_project_path(@project), method: :patch, multipart: true, class: "flex gap-2 items-end") do |f| %>
        <%= f.file_field :signed_contract, class: "file-input file-input-bordered file-input-sm flex-1" %>
        <%= f.submit "Upload", class: "btn btn-sm btn-primary" %>
      <% end %>
    </div>
  </div>
</div>

<!-- Source Bid -->
<% if @project.source_bid %>
  <div class="card bg-base-100 shadow mb-6">
    <div class="card-body">
      <h3 class="card-title text-base">Source Bid</h3>
      <div class="flex items-center gap-4">
        <%= link_to admin_bid_path(@project.source_bid), class: "link link-primary" do %>
          <i class="fas fa-file-invoice-dollar mr-1"></i> <%= @project.source_bid.title %>
        <% end %>
        <span class="badge badge-success badge-sm"><%= @project.source_bid.status.capitalize %></span>
        <span class="text-sm opacity-60"><%= number_to_currency(@project.source_bid.total) %></span>
      </div>
    </div>
  </div>
<% end %>

<!-- Bids (other than source) -->
<% other_bids = @bids.reject { |b| b.id == @project.source_bid_id } %>
<% if other_bids.any? %>
  <div class="card bg-base-100 shadow mb-6">
    <div class="card-body">
      <h3 class="card-title text-base">Other Bids</h3>
      <div class="overflow-x-auto">
        <table class="table">
          <thead>
            <tr><th>Title</th><th>Total</th><th>Status</th><th>Created</th><th>Actions</th></tr>
          </thead>
          <tbody>
            <% other_bids.each do |bid| %>
              <tr>
                <td class="font-medium"><%= link_to bid.title, admin_bid_path(bid), class: "link link-primary" %></td>
                <td><%= number_to_currency(bid.total) %></td>
                <td>
                  <% badge_class = { "draft" => "badge-ghost", "sent" => "badge-info", "accepted" => "badge-success", "rejected" => "badge-error" }[bid.status] %>
                  <span class="badge <%= badge_class %> badge-sm"><%= bid.status.capitalize %></span>
                </td>
                <td class="text-sm"><%= local_time(bid.created_at) %></td>
                <td>
                  <%= link_to admin_bid_path(bid), class: "btn btn-ghost btn-xs" do %>
                    <i class="fas fa-eye"></i>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
<% end %>

<!-- Invoices -->
<div class="card bg-base-100 shadow">
  <div class="card-body">
    <h3 class="card-title text-base">Invoices</h3>
    <% if @invoices.any? %>
      <div class="overflow-x-auto">
        <table class="table">
          <thead>
            <tr><th>#</th><th>Type</th><th>Total</th><th>Status</th><th>Created</th><th>Actions</th></tr>
          </thead>
          <tbody>
            <% @invoices.each do |invoice| %>
              <tr>
                <td><%= invoice.id %></td>
                <td>
                  <% type_badge = case invoice.payment_type
                     when "deposit" then "badge-primary"
                     when "final" then "badge-success"
                     when "infrastructure" then "badge-info"
                     else "badge-ghost"
                     end %>
                  <span class="badge <%= type_badge %> badge-sm"><%= invoice.payment_type_label %></span>
                </td>
                <td class="font-medium"><%= number_to_currency(invoice.total) %></td>
                <td>
                  <% badge_class = { "draft" => "badge-ghost", "sent" => "badge-info", "paid" => "badge-success", "void" => "badge-error" }[invoice.status] %>
                  <span class="badge <%= badge_class %> badge-sm"><%= invoice.status.capitalize %></span>
                </td>
                <td class="text-sm"><%= local_time(invoice.created_at) %></td>
                <td>
                  <%= link_to admin_invoice_path(invoice), class: "btn btn-ghost btn-xs" do %>
                    <i class="fas fa-eye"></i>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="text-sm opacity-60">No invoices yet.</p>
    <% end %>
  </div>
</div>
