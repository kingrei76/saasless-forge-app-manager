<div class="flex justify-between items-center mb-6">
  <h2 class="text-2xl font-bold">Projects</h2>
  <p class="text-sm opacity-60">Projects are created by accepting bids</p>
</div>

<!-- Status Filter -->
<div class="flex gap-2 mb-4 flex-wrap">
  <span class="text-sm opacity-60 self-center mr-2">Status:</span>
  <%= link_to "All", admin_projects_path(stage: params[:stage]), class: "btn btn-sm #{params[:status].blank? ? 'btn-primary' : 'btn-ghost'}" %>
  <% %w[active on_hold completed cancelled].each do |status| %>
    <%= link_to status.titleize, admin_projects_path(status: status, stage: params[:stage]), class: "btn btn-sm #{params[:status] == status ? 'btn-primary' : 'btn-ghost'}" %>
  <% end %>
</div>

<!-- Stage Filter -->
<div class="flex gap-2 mb-4 flex-wrap">
  <span class="text-sm opacity-60 self-center mr-2">Stage:</span>
  <%= link_to "All", admin_projects_path(status: params[:status]), class: "btn btn-sm #{params[:stage].blank? ? 'btn-primary' : 'btn-ghost'}" %>
  <% Project::STAGES.each do |stage| %>
    <%= link_to Project::STAGE_LABELS[stage], admin_projects_path(status: params[:status], stage: stage), class: "btn btn-sm #{params[:stage] == stage ? 'btn-primary' : 'btn-ghost'}" %>
  <% end %>
</div>

<div class="overflow-x-auto bg-base-100 rounded-box shadow">
  <table class="table">
    <thead>
      <tr>
        <th>Title</th>
        <th>Client</th>
        <th>Stage</th>
        <th>Assignee</th>
        <th>Hours</th>
        <th>Status</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @projects.each do |project| %>
        <tr>
          <td class="font-medium"><%= link_to project.title, admin_project_path(project), class: "link link-primary" %></td>
          <td><%= project.client.name %></td>
          <td>
            <% if project.stage %>
              <span class="badge badge-outline badge-sm"><%= project.stage_label %></span>
            <% else %>
              <span class="text-sm opacity-60">—</span>
            <% end %>
          </td>
          <td class="text-sm"><%= project.assignee&.name || "Unassigned" %></td>
          <td class="text-sm">
            <%= project.actual_hours %>
            <% if project.estimated_hours %>
              <span class="opacity-60">/ <%= project.estimated_hours %></span>
            <% end %>
          </td>
          <td>
            <% badge_class = { "active" => "badge-success", "on_hold" => "badge-warning", "completed" => "badge-info", "cancelled" => "badge-error" }[project.status] %>
            <span class="badge <%= badge_class %> badge-sm"><%= project.status.titleize %></span>
          </td>
          <td class="flex gap-1">
            <%= link_to admin_project_path(project), class: "btn btn-ghost btn-xs" do %>
              <i class="fas fa-eye"></i>
            <% end %>
            <%= link_to edit_admin_project_path(project), class: "btn btn-ghost btn-xs" do %>
              <i class="fas fa-edit"></i>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
