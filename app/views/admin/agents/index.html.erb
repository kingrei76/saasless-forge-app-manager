<div class="flex justify-between items-center mb-6">
  <h2 class="text-2xl font-bold">AI Agents</h2>
  <%= link_to new_admin_agent_path, class: "btn btn-primary btn-sm" do %>
    <i class="fas fa-plus mr-1"></i> New Agent
  <% end %>
</div>

<!-- Stats -->
<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
  <div class="stat bg-base-100 rounded-box shadow">
    <div class="stat-title">Total Agents</div>
    <div class="stat-value text-lg"><%= @stats[:total] %></div>
  </div>
  <div class="stat bg-base-100 rounded-box shadow">
    <div class="stat-title">Active</div>
    <div class="stat-value text-lg text-success"><%= @stats[:active] %></div>
  </div>
  <div class="stat bg-base-100 rounded-box shadow">
    <div class="stat-title">Executions Today</div>
    <div class="stat-value text-lg"><%= @stats[:executions_today] %></div>
  </div>
  <div class="stat bg-base-100 rounded-box shadow">
    <div class="stat-title">Open Alerts</div>
    <div class="stat-value text-lg text-error"><%= @stats[:open_alerts] %></div>
  </div>
</div>

<!-- Filters -->
<div class="card bg-base-100 shadow mb-6">
  <div class="card-body py-3">
    <%= form_with(url: admin_agents_path, method: :get, data: { controller: "filter", filter_target: "form", action: "input->filter#submit" }) do |f| %>
      <div class="flex flex-wrap gap-4 items-end">
        <div class="form-control">
          <label class="label"><span class="label-text">Search</span></label>
          <%= f.text_field :search, value: params[:search], class: "input input-bordered input-sm", placeholder: "Search agents..." %>
        </div>
        <div class="form-control">
          <label class="label"><span class="label-text">Status</span></label>
          <%= f.select :status, Agent::STATUSES.map { |s| [s.capitalize, s] }, { include_blank: "All" }, class: "select select-bordered select-sm", data: { action: "change->filter#submit" } %>
        </div>
        <div class="form-control">
          <label class="label"><span class="label-text">Category</span></label>
          <%= f.select :category, Agent::CATEGORIES.map { |c| [c.capitalize, c] }, { include_blank: "All" }, class: "select select-bordered select-sm", data: { action: "change->filter#submit" } %>
        </div>
        <div class="form-control">
          <label class="label"><span class="label-text">Mode</span></label>
          <%= f.select :mode, Agent::MODES.map { |m| [m.capitalize, m] }, { include_blank: "All" }, class: "select select-bordered select-sm", data: { action: "change->filter#submit" } %>
        </div>
        <div>
          <%= f.submit "Filter", class: "btn btn-primary btn-sm" %>
          <%= link_to "Clear", admin_agents_path, class: "btn btn-ghost btn-sm" %>
        </div>
      </div>
    <% end %>
  </div>
</div>

<!-- Agent Table -->
<div class="overflow-x-auto bg-base-100 rounded-box shadow">
  <table class="table">
    <thead>
      <tr>
        <th>Name</th>
        <th>Category</th>
        <th>Status</th>
        <th>Mode</th>
        <th>Model</th>
        <th>Tools</th>
        <th>Version</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @agents.each do |agent| %>
        <tr>
          <td>
            <%= link_to agent.name, admin_agent_path(agent), class: "link link-primary font-medium" %>
            <br><span class="text-xs opacity-60"><%= agent.slug %></span>
          </td>
          <td><span class="badge badge-<%= agent.category_badge_color %> badge-sm"><%= agent.category %></span></td>
          <td><span class="badge badge-<%= agent.status_badge_color %> badge-sm"><%= agent.status %></span></td>
          <td>
            <span class="badge badge-<%= agent.test_mode? ? 'warning' : 'success' %> badge-outline badge-sm">
              <i class="fas fa-<%= agent.test_mode? ? 'flask' : 'broadcast-tower' %> mr-1"></i>
              <%= agent.mode %>
            </span>
          </td>
          <td class="text-sm"><%= agent.llm_model || "—" %></td>
          <td><%= agent.agent_tools.enabled.count %></td>
          <td>v<%= agent.version %></td>
          <td class="flex gap-1">
            <%= link_to admin_agent_path(agent), class: "btn btn-ghost btn-xs" do %>
              <i class="fas fa-eye"></i>
            <% end %>
            <%= link_to edit_admin_agent_path(agent), class: "btn btn-ghost btn-xs" do %>
              <i class="fas fa-edit"></i>
            <% end %>
            <%= button_to admin_agent_path(agent), method: :delete,
                class: "btn btn-ghost btn-xs text-error",
                data: { turbo_confirm: "Delete #{agent.name}?" } do %>
              <i class="fas fa-trash"></i>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <% if @agents.empty? %>
    <div class="text-center py-8 opacity-60">
      <i class="fas fa-robot text-4xl mb-2"></i>
      <p>No agents yet. <%= link_to "Create your first agent", new_admin_agent_path, class: "link link-primary" %>.</p>
    </div>
  <% end %>
</div>
