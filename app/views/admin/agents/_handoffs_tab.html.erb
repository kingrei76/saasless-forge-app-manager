<!-- Add Handoff Form -->
<div class="card bg-base-100 shadow mb-6">
  <div class="card-body">
    <h3 class="card-title text-lg">Add Handoff</h3>
    <% if @available_agents.any? %>
      <%= form_with(url: admin_agent_agent_handoffs_path(@agent), method: :post, class: "flex flex-wrap gap-3 items-end") do |f| %>
        <div class="form-control flex-1">
          <label class="label"><span class="label-text">Target Agent</span></label>
          <select name="agent_handoff[target_agent_id]" class="select select-bordered select-sm">
            <% @available_agents.each do |a| %>
              <option value="<%= a.id %>"><%= a.name %> (<%= a.category %>)</option>
            <% end %>
          </select>
        </div>
        <div class="form-control">
          <label class="label"><span class="label-text">Name</span></label>
          <input type="text" name="agent_handoff[name]" class="input input-bordered input-sm" placeholder="e.g. Escalate to support">
        </div>
        <div class="form-control">
          <label class="label"><span class="label-text">Priority</span></label>
          <input type="number" name="agent_handoff[priority]" value="0" class="input input-bordered input-sm w-20">
        </div>
        <button type="submit" class="btn btn-primary btn-sm">
          <i class="fas fa-plus mr-1"></i> Add
        </button>
      <% end %>
    <% else %>
      <p class="opacity-60">No other agents available for handoffs. Create more agents first.</p>
    <% end %>
  </div>
</div>

<!-- Handoff List -->
<div class="overflow-x-auto bg-base-100 rounded-box shadow">
  <table class="table">
    <thead>
      <tr>
        <th>Target Agent</th>
        <th>Name</th>
        <th>Priority</th>
        <th>Enabled</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @handoffs.each do |h| %>
        <tr>
          <td>
            <%= link_to h.target_agent.name, admin_agent_path(h.target_agent), class: "link link-primary" %>
            <br><span class="text-xs opacity-60"><%= h.target_agent.category %></span>
          </td>
          <td><%= h.name || "—" %></td>
          <td><%= h.priority %></td>
          <td><span class="badge badge-<%= h.enabled? ? 'success' : 'ghost' %> badge-sm"><%= h.enabled? ? "Active" : "Disabled" %></span></td>
          <td>
            <%= button_to admin_agent_agent_handoff_path(@agent, h), method: :delete, class: "btn btn-ghost btn-xs text-error", data: { turbo_confirm: "Remove this handoff?" } do %>
              <i class="fas fa-trash"></i>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <% if @handoffs.empty? %>
    <div class="text-center py-8 opacity-60">
      <p>No handoffs configured.</p>
    </div>
  <% end %>
</div>
