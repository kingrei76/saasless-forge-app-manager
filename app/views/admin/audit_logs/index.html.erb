<h2 class="text-2xl font-bold mb-6">Audit Log</h2>

<div class="overflow-x-auto bg-base-100 rounded-box shadow">
  <table class="table">
    <thead>
      <tr>
        <th>Time</th>
        <th>User</th>
        <th>Action</th>
        <th>Resource</th>
        <th>Details</th>
      </tr>
    </thead>
    <tbody>
      <% @audit_logs.each do |log| %>
        <tr>
          <td class="text-sm"><%= log.created_at.strftime("%b %d, %Y %H:%M") %></td>
          <td><%= log.user&.email || "System" %></td>
          <td><span class="badge badge-outline badge-sm"><%= log.action %></span></td>
          <td class="text-sm"><%= "#{log.auditable_type} ##{log.auditable_id}" if log.auditable_type %></td>
          <td>
            <%= link_to admin_audit_log_path(log), class: "btn btn-ghost btn-xs" do %>
              <i class="fas fa-eye"></i>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
