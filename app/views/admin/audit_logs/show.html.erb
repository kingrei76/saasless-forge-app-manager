<h2 class="text-2xl font-bold mb-6">Audit Log Entry</h2>

<div class="card bg-base-100 shadow max-w-xl">
  <div class="card-body">
    <div class="grid grid-cols-2 gap-4 text-sm">
      <div><span class="opacity-60">Time</span><p class="font-medium"><%= local_time(@audit_log.created_at, "long-datetime") %></p></div>
      <div><span class="opacity-60">User</span><p class="font-medium"><%= @audit_log.user&.email || "System" %></p></div>
      <div><span class="opacity-60">Action</span><p class="font-medium"><%= @audit_log.action %></p></div>
      <div><span class="opacity-60">Resource</span><p class="font-medium"><%= "#{@audit_log.auditable_type} ##{@audit_log.auditable_id}" if @audit_log.auditable_type %></p></div>
    </div>

    <% if @audit_log.changes_data.present? %>
      <div class="divider"></div>
      <h3 class="font-bold text-sm mb-2">Changes</h3>
      <pre class="bg-base-200 p-4 rounded-box text-sm overflow-x-auto"><%= JSON.pretty_generate(@audit_log.changes_data) %></pre>
    <% end %>

    <div class="mt-4">
      <%= link_to "Back to Audit Log", admin_audit_logs_path, class: "btn btn-ghost btn-sm" %>
    </div>
  </div>
</div>
