<div class="flex justify-between items-center mb-6">
  <h2 class="text-2xl font-bold">Tool Registry</h2>
</div>

<!-- Filters -->
<div class="card bg-base-100 shadow mb-6">
  <div class="card-body py-3">
    <%= form_with(url: admin_tool_definitions_path, method: :get, data: { controller: "filter", filter_target: "form", action: "input->filter#submit" }) do |f| %>
      <div class="flex flex-wrap gap-4 items-end">
        <div class="form-control">
          <label class="label"><span class="label-text">Search</span></label>
          <%= f.text_field :search, value: params[:search], class: "input input-bordered input-sm", placeholder: "Search tools..." %>
        </div>
        <div class="form-control">
          <label class="label"><span class="label-text">Category</span></label>
          <%= f.select :category, ToolDefinition::CATEGORIES.map { |c| [c.capitalize, c] }, { include_blank: "All" }, class: "select select-bordered select-sm", data: { action: "change->filter#submit" } %>
        </div>
        <div class="form-control">
          <label class="label"><span class="label-text">Status</span></label>
          <%= f.select :status, ToolDefinition::STATUSES.map { |s| [s.capitalize, s] }, { include_blank: "All" }, class: "select select-bordered select-sm", data: { action: "change->filter#submit" } %>
        </div>
        <div>
          <%= f.submit "Filter", class: "btn btn-primary btn-sm" %>
          <%= link_to "Clear", admin_tool_definitions_path, class: "btn btn-ghost btn-sm" %>
        </div>
      </div>
    <% end %>
  </div>
</div>

<!-- Tools Table -->
<div class="overflow-x-auto bg-base-100 rounded-box shadow">
  <table class="table">
    <thead>
      <tr>
        <th>Name</th>
        <th>Category</th>
        <th>Risk Level</th>
        <th>Status</th>
        <th>Handler</th>
        <th>Agents Using</th>
        <th>Version</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @tools.each do |tool| %>
        <tr>
          <td>
            <%= link_to tool.name, admin_tool_definition_path(tool), class: "link link-primary font-medium" %>
            <br><span class="text-xs opacity-60"><%= tool.description&.truncate(50) %></span>
          </td>
          <td><span class="badge badge-outline badge-sm"><%= tool.category %></span></td>
          <td><span class="badge badge-<%= tool.risk_badge_color %> badge-sm"><%= tool.risk_level %></span></td>
          <td><span class="badge badge-<%= tool.status_badge_color %> badge-sm"><%= tool.status %></span></td>
          <td class="text-xs font-mono"><%= tool.handler_class || "—" %></td>
          <td><%= tool.agents.count %></td>
          <td>v<%= tool.version %></td>
          <td>
            <%= link_to admin_tool_definition_path(tool), class: "btn btn-ghost btn-xs" do %>
              <i class="fas fa-eye"></i>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <% if @tools.empty? %>
    <div class="text-center py-8 opacity-60">
      <i class="fas fa-wrench text-4xl mb-2"></i>
      <p>No tools registered. Run <code>rails agent_tools:sync</code> to discover tools.</p>
    </div>
  <% end %>
</div>
