<div class="flex justify-between items-center mb-6">
  <h2 class="text-2xl font-bold">App Cost Monitoring</h2>
  <div class="flex gap-2">
    <%= button_to sync_render_admin_cost_entries_path(client_id: @selected_client&.id), method: :post, class: "btn btn-outline btn-sm" do %>
      <i class="fas fa-sync mr-1"></i> Sync from Render
    <% end %>
    <%= link_to new_admin_cost_entry_path, class: "btn btn-primary btn-sm" do %>
      <i class="fas fa-plus mr-1"></i> Add Manual Entry
    <% end %>
  </div>
</div>

<%# Client Filter %>
<div class="bg-base-100 rounded-box shadow p-4 mb-6">
  <div class="flex flex-wrap gap-4 items-end">
    <div class="form-control">
      <label class="label">
        <span class="label-text font-medium">Filter by Client</span>
      </label>
      <%= form_tag admin_cost_entries_path, method: :get, class: "flex gap-2" do %>
        <%= select_tag :client_id,
            options_from_collection_for_select(@clients_for_select, :id, :name, @selected_client&.id),
            include_blank: "All Clients",
            class: "select select-bordered select-sm w-64",
            onchange: "this.form.submit()" %>
      <% end %>
    </div>

    <div class="flex-1"></div>

    <div class="text-right">
      <div class="text-sm opacity-70">Billing Period</div>
      <div class="font-semibold">
        <%= @billing_period_start.strftime("%b %d") %> - <%= @billing_period_end.strftime("%b %d, %Y") %>
      </div>
      <div class="text-xs opacity-60">
        Day <%= @days_into_cycle %> of <%= @days_in_cycle %> (<%= @cycle_progress %>%)
      </div>
    </div>
  </div>
</div>

<% if @unified_costs.present? %>
  <%# Unified Costs by App Table with charge-level detail %>
  <div class="overflow-x-auto bg-base-100 rounded-box shadow mb-6">
    <table class="table table-sm">
      <thead>
        <tr>
          <th>App / Charge</th>
          <th>Type</th>
          <th class="text-right">Current Cost</th>
          <th class="text-right">Est. Monthly</th>
          <th class="text-center">Days Active</th>
          <% unless @selected_client %>
            <th>Client</th>
          <% end %>
        </tr>
      </thead>
      <tbody>
        <% @unified_costs.values.sort_by { |data| data[:app]&.name.to_s.downcase }.each do |data| %>
          <% app = data[:app] %>
          <% next unless app %>
          <% prorate = data[:days_in_period].to_i > 0 ? data[:days_active].to_f / data[:days_in_period] : 1.0 %>

          <%# === App summary row === %>
          <tr class="bg-base-200/50 font-semibold border-t-2 border-base-300">
            <td>
              <%= link_to app.name, admin_app_path(app), class: "link link-primary" %>
            </td>
            <td></td>
            <td class="text-right"><%= number_to_currency(data[:total_cost]) %></td>
            <td class="text-right"><%= number_to_currency(data[:total_projected]) %></td>
            <td class="text-center"><%= data[:days_active] %> / <%= data[:days_in_period] %></td>
            <% unless @selected_client %>
              <td><%= data[:clients]&.join(", ") %></td>
            <% end %>
          </tr>

          <%# === Per-service charge detail rows === %>
          <% services = data[:render_services].presence || [] %>
          <% calculated = (data[:services] || []).index_by(&:render_service_id) %>

          <% services.each do |rs| %>
            <% cc = calculated[rs.render_service_id] %>
            <% svc_label = rs.service_type == "postgres" ? "DB" : rs.service_type_label %>

            <%# Compute %>
            <tr class="text-sm">
              <td class="pl-8">
                <i class="fas <%= rs.service_icon %> text-xs opacity-50 mr-1"></i>
                <%= rs.name %>
              </td>
              <td><%= rs.plan %></td>
              <td class="text-right">
                <%= number_to_currency(cc ? cc.base_cost : rs.monthly_price * prorate) %>
              </td>
              <td class="text-right opacity-70">
                <%= number_to_currency(rs.monthly_price) %>/mo
              </td>
              <td></td>
              <% unless @selected_client %><td></td><% end %>
            </tr>

            <%# Disk (databases only) %>
            <% if rs.service_type == "postgres" %>
              <% disk_gb = rs.disk_size_gb || 0 %>
              <% disk_monthly = rs.disk_monthly_cost %>
              <tr class="text-sm">
                <td class="pl-12 opacity-70">Disk (<%= disk_gb %> GB)</td>
                <td class="opacity-70">storage</td>
                <td class="text-right">
                  <%= number_to_currency(cc ? cc.storage_cost : disk_monthly * prorate) %>
                </td>
                <td class="text-right opacity-70">
                  <%= number_to_currency(disk_monthly) %>/mo
                </td>
                <td></td>
                <% unless @selected_client %><td></td><% end %>
              </tr>
            <% end %>

            <%# Outgoing Bandwidth %>
            <% bw_cost = cc ? cc.bandwidth_cost : 0 %>
            <tr class="text-sm opacity-50">
              <td class="pl-12">Outgoing Bandwidth</td>
              <td>network</td>
              <td class="text-right"><%= number_to_currency(bw_cost) %></td>
              <td class="text-right"><%= number_to_currency(bw_cost > 0 ? (bw_cost / prorate) : 0) %>/mo</td>
              <td></td>
              <% unless @selected_client %><td></td><% end %>
            </tr>

            <%# Private Link %>
            <tr class="text-sm opacity-50">
              <td class="pl-12">Private Link</td>
              <td>network</td>
              <td class="text-right"><%= number_to_currency(0) %></td>
              <td class="text-right"><%= number_to_currency(0) %>/mo</td>
              <td></td>
              <% unless @selected_client %><td></td><% end %>
            </tr>
          <% end %>

          <%# === Pipeline Minutes (account-level, per app) === %>
          <% if services.any? %>
            <tr class="text-sm opacity-50">
              <td class="pl-8"><i class="fas fa-hammer text-xs opacity-50 mr-1"></i> Pipeline Minutes</td>
              <td>build</td>
              <td class="text-right"><%= number_to_currency(0) %></td>
              <td class="text-right"><%= number_to_currency(0) %>/mo</td>
              <td></td>
              <% unless @selected_client %><td></td><% end %>
            </tr>
          <% end %>

          <%# === AI API costs === %>
          <% if data[:api_calls].to_i > 0 %>
            <tr class="text-sm">
              <td class="pl-8"><i class="fas fa-brain text-xs opacity-50 mr-1"></i> AI API (<%= data[:api_calls] %> calls)</td>
              <td>api</td>
              <td class="text-right"><%= number_to_currency(data[:api_cost]) %></td>
              <td class="text-right opacity-70"><%= number_to_currency(data[:api_projected]) %>/mo</td>
              <td></td>
              <% unless @selected_client %><td></td><% end %>
            </tr>
          <% end %>
        <% end %>
      </tbody>
      <tfoot>
        <tr class="font-bold bg-base-200">
          <td colspan="2">Total</td>
          <td class="text-right text-primary"><%= number_to_currency(@grand_total_current) %></td>
          <td class="text-right"><%= number_to_currency(@grand_total_projected) %></td>
          <td></td>
          <% unless @selected_client %>
            <td></td>
          <% end %>
        </tr>
      </tfoot>
    </table>
  </div>
<% else %>
  <div class="alert alert-info mb-6">
    <i class="fas fa-info-circle"></i>
    <div>
      <p>No costs found for this billing period.</p>
      <ol class="list-decimal list-inside mt-2 text-sm opacity-80 space-y-1">
        <li>Add GitHub accounts with Render API keys at <strong><%= link_to "GitHub Accounts", admin_github_accounts_path, class: "link" %></strong></li>
        <li>Sync apps from GitHub at <strong><%= link_to "Apps", admin_apps_path, class: "link" %></strong></li>
        <li>Click <strong>"Sync from Render"</strong> above to fetch infrastructure costs</li>
      </ol>
    </div>
  </div>
<% end %>

<%# Manual Entries Section %>
<% if @manual_entries.present? %>
  <div class="mb-6">
    <h3 class="text-lg font-semibold mb-3">Manual Cost Entries</h3>
    <div class="overflow-x-auto bg-base-100 rounded-box shadow">
      <table class="table">
        <thead>
          <tr>
            <th>App</th>
            <th>Service</th>
            <th class="text-right">Amount</th>
            <th>Period</th>
            <th>Notes</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @manual_entries.each do |entry| %>
            <tr>
              <td><%= link_to entry.app.name, admin_app_path(entry.app), class: "link link-primary" %></td>
              <td><%= entry.service_name %></td>
              <td class="text-right font-medium"><%= number_to_currency(entry.amount) %></td>
              <td class="text-sm"><%= entry.period_start %> - <%= entry.period_end %></td>
              <td class="text-sm opacity-70 max-w-xs truncate"><%= entry.notes %></td>
              <td class="flex gap-1">
                <%= link_to edit_admin_cost_entry_path(entry), class: "btn btn-ghost btn-xs" do %>
                  <i class="fas fa-edit"></i>
                <% end %>
                <%= button_to admin_cost_entry_path(entry), method: :delete, class: "btn btn-ghost btn-xs text-error", data: { turbo_confirm: "Delete?" } do %>
                  <i class="fas fa-trash"></i>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% end %>
