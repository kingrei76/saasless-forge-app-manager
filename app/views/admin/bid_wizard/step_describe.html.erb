<div class="max-w-3xl mx-auto">
  <h2 class="text-2xl font-bold mb-2">Create Bid with AI</h2>
  <p class="text-base-content/60 mb-6">Describe your project and let Grok help you create an accurate bid.</p>

  <%= render "admin/bid_wizard/wizard_steps", current_step: "describe" %>

  <%= form_with(url: admin_bid_wizard_path(@bid), method: :patch, class: "space-y-6", data: { controller: "bid-wizard" }) do |f| %>
    <div class="card bg-base-100 shadow">
      <div class="card-body">
        <h3 class="card-title text-lg">
          <i class="fas fa-pencil-alt text-primary mr-2"></i>
          Project Description
        </h3>

        <div class="form-control">
          <label class="label">
            <span class="label-text font-medium">Describe the project in detail</span>
          </label>
          <%= text_area_tag :project_description, @bid.project_description,
              class: "textarea textarea-bordered h-40",
              placeholder: "Describe what you're building, key features, technical requirements, and any specific constraints or preferences...",
              required: true %>
          <label class="label">
            <span class="label-text-alt">The more detail you provide, the more accurate the bid will be.</span>
          </label>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-4">
          <div class="form-control">
            <label class="label">
              <span class="label-text font-medium">Client</span>
              <button type="button" class="btn btn-ghost btn-xs text-primary" data-action="click->bid-wizard#openNewClientModal">
                <i class="fas fa-plus mr-1"></i> New Client
              </button>
            </label>
            <input type="text"
                   class="input input-bordered w-full"
                   placeholder="Search clients..."
                   data-bid-wizard-target="clientSearch"
                   data-action="input->bid-wizard#filterClients">
            <select name="client_id"
                    class="select select-bordered w-full mt-2"
                    data-bid-wizard-target="clientSelect"
                    data-action="change->bid-wizard#filterAppsByClient">
              <option value="">-- Select Client --</option>
              <% @clients.each do |client| %>
                <option value="<%= client.id %>" <%= 'selected' if @bid.client_id == client.id %>><%= client.name %></option>
              <% end %>
            </select>
          </div>

          <div class="form-control">
            <label class="label">
              <span class="label-text font-medium">Project Scope</span>
            </label>
            <%= select_tag :project_scope,
                options_for_select([
                  ["Quick Fix / Tweak (1-4 hrs)", "quick_fix"],
                  ["Small Feature (4-16 hrs)", "small_feature"],
                  ["Medium Feature (16-40 hrs)", "medium_feature"],
                  ["Large Feature / Module (40-80 hrs)", "large_feature"],
                  ["Full Application (80+ hrs)", "full_app"]
                ], @bid.project_scope || "small_feature"),
                class: "select select-bordered w-full" %>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-4">
          <div class="form-control">
            <label class="label">
              <span class="label-text font-medium">Bid Title</span>
            </label>
            <%= text_field_tag :title, @bid.title, class: "input input-bordered w-full", placeholder: "Project name or title (auto-generated from description)" %>
            <label class="label">
              <span class="label-text-alt">Leave as default to auto-generate from description</span>
            </label>
          </div>

          <div class="form-control">
            <label class="label">
              <span class="label-text font-medium">Hourly Rate</span>
            </label>
            <label class="input input-bordered flex items-center gap-2">
              <span class="text-base-content/50">$</span>
              <%= number_field_tag :hourly_rate, @bid.hourly_rate, class: "grow", step: 0.01, min: 0 %>
              <span class="text-base-content/50">/hr</span>
            </label>
          </div>
        </div>
      </div>
    </div>

    <div class="card bg-base-100 shadow">
      <div class="card-body">
        <h3 class="card-title text-lg">
          <i class="fas fa-cube text-primary mr-2"></i>
          Apps
          <span class="badge badge-error badge-sm ml-2">Required</span>
        </h3>
        <p class="text-sm text-base-content/60 mb-2">Select an existing app or add a new one for this project.</p>
        <div class="alert alert-info py-2 mb-4">
          <i class="fas fa-code-branch"></i>
          <span class="text-sm">Selecting existing apps allows AI to analyze their GitHub repos for more accurate scoping.</span>
        </div>

        <!-- Validation message -->
        <div class="alert alert-error hidden" data-bid-wizard-target="appValidation">
          <i class="fas fa-exclamation-circle"></i>
          <span>Please select at least one existing app or add a new app name.</span>
        </div>

        <% if @apps.present? %>
          <div class="form-control mb-4">
            <label class="label">
              <span class="label-text font-medium">Existing Apps</span>
            </label>
            <input type="text"
                   class="input input-bordered input-sm w-full mb-2"
                   placeholder="Search apps..."
                   data-bid-wizard-target="appSearch"
                   data-action="input->bid-wizard#filterApps">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-2 max-h-60 overflow-y-auto" data-bid-wizard-target="appList">
              <% selected_app_ids = @bid.bid_apps.map(&:app_id).compact %>
              <% @apps.each do |app| %>
                <label class="flex items-center gap-2 p-2 rounded border border-base-300 hover:bg-base-200 cursor-pointer app-item"
                       data-app-id="<%= app.id %>"
                       data-app-name="<%= app.name.downcase %>"
                       data-client-ids="<%= app.app_assignments.pluck(:client_id).join(',') %>">
                  <%= check_box_tag "app_ids[]", app.id, selected_app_ids.include?(app.id), class: "checkbox checkbox-sm checkbox-primary", data: { action: "change->bid-wizard#validateApps" } %>
                  <span class="text-sm"><%= app.name %></span>
                  <% if app.language.present? %>
                    <span class="badge badge-ghost badge-xs"><%= app.language %></span>
                  <% end %>
                </label>
              <% end %>
            </div>
          </div>
        <% end %>

        <div class="divider">OR</div>

        <div class="form-control">
          <label class="label">
            <span class="label-text font-medium">New Apps</span>
            <span class="label-text-alt">Add apps that will be created for this project</span>
          </label>
          <div id="new-apps-container" class="space-y-2" data-bid-wizard-target="newAppsContainer">
            <% existing_new_apps = @bid.bid_apps.select(&:new_app?).map(&:new_app_name) %>
            <% existing_new_apps.each do |name| %>
              <div class="flex gap-2 new-app-row">
                <input type="text" name="new_app_names[]" value="<%= name %>" class="input input-bordered input-sm flex-1" placeholder="New app name" data-action="input->bid-wizard#validateApps">
                <button type="button" class="btn btn-ghost btn-sm text-error" data-action="click->bid-wizard#removeNewApp">
                  <i class="fas fa-times"></i>
                </button>
              </div>
            <% end %>
          </div>
          <button type="button" class="btn btn-ghost btn-sm mt-2 w-fit" data-action="click->bid-wizard#addNewApp">
            <i class="fas fa-plus mr-1"></i> Add New App
          </button>
        </div>
      </div>
    </div>

    <div class="flex justify-between gap-2">
      <%= link_to admin_bids_path, class: "btn btn-ghost" do %>
        <i class="fas fa-times mr-1"></i> Cancel
      <% end %>
      <%= f.submit "Continue", class: "btn btn-primary", data: { action: "click->bid-wizard#validateAndSubmit", turbo_submits_with: "Generating questions..." } %>
    </div>
  <% end %>

  <!-- New Client Modal -->
  <dialog class="modal" data-bid-wizard-target="newClientModal">
    <div class="modal-box">
      <h3 class="text-lg font-bold mb-4">
        <i class="fas fa-user-plus text-primary mr-2"></i>
        New Client
      </h3>

      <div class="alert alert-error hidden mb-4" data-bid-wizard-target="newClientErrors"></div>

      <form action="<%= admin_clients_path %>" data-turbo="false" data-bid-wizard-target="newClientForm" data-action="submit->bid-wizard#submitNewClient" class="space-y-4">
        <div class="form-control">
          <label class="label"><span class="label-text">Name</span></label>
          <input type="text" name="client[name]" class="input input-bordered w-full" required>
        </div>

        <div class="form-control">
          <label class="label"><span class="label-text">Email</span></label>
          <input type="email" name="client[email]" class="input input-bordered w-full">
        </div>

        <div class="form-control">
          <label class="label"><span class="label-text">Company</span></label>
          <input type="text" name="client[company]" class="input input-bordered w-full">
        </div>

        <div class="modal-action">
          <button type="button" class="btn btn-ghost" data-action="click->bid-wizard#closeNewClientModal">Cancel</button>
          <button type="submit" class="btn btn-primary">Create Client</button>
        </div>
      </form>
    </div>
    <form method="dialog" class="modal-backdrop"><button>close</button></form>
  </dialog>
</div>
