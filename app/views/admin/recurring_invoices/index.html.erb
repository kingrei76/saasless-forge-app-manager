<div class="flex justify-between items-center mb-6">
  <h2 class="text-2xl font-bold">Recurring Billing</h2>
  <div class="flex gap-2">
    <%= button_to admin_generate_recurring_drafts_path, method: :post, class: "btn btn-outline btn-sm", data: { turbo_confirm: "Generate draft invoices for all due recurring billing configs?" } do %>
      <i class="fas fa-file-invoice mr-1"></i> Generate Draft Invoices
    <% end %>
    <%= button_to admin_process_recurring_billing_path, method: :post, class: "btn btn-outline btn-sm", data: { turbo_confirm: "Process all due recurring invoices and send to Stripe immediately?" } do %>
      <i class="fas fa-sync mr-1"></i> Process & Send Due Now
    <% end %>
    <%= link_to new_admin_recurring_invoice_path, class: "btn btn-primary btn-sm" do %>
      <i class="fas fa-plus mr-1"></i> New Recurring Invoice
    <% end %>
  </div>
</div>

<% if @recurring_invoices.empty? %>
  <div class="card bg-base-100 shadow">
    <div class="card-body text-center py-12">
      <i class="fas fa-sync-alt text-4xl opacity-30 mb-4"></i>
      <p class="text-lg font-medium">No recurring invoices yet</p>
      <p class="text-sm opacity-60 mb-4">Set up automatic monthly billing for your clients.</p>
      <%= link_to new_admin_recurring_invoice_path, class: "btn btn-primary btn-sm" do %>
        <i class="fas fa-plus mr-1"></i> Create First Recurring Invoice
      <% end %>
    </div>
  </div>
<% else %>
  <div class="card bg-base-100 shadow mb-6">
    <div class="card-body">
      <div class="overflow-x-auto">
        <table class="table">
          <thead>
            <tr>
              <th>Client</th>
              <th>Status</th>
              <th>Collection Method</th>
              <th>Billing Day</th>
              <th>Last Bill</th>
              <th>Est. Next Bill</th>
              <th>Next Billing</th>
              <th>Last Billed</th>
              <th>Invoices</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @recurring_invoices.each do |ri| %>
              <tr>
                <td class="font-medium">
                  <%= link_to ri.client.name, admin_client_path(ri.client), class: "link link-primary" %>
                </td>
                <td>
                  <span class="badge <%= ri.status_badge_class %> badge-sm"><%= ri.status.capitalize %></span>
                </td>
                <td>
                  <% if ri.charge_automatically? %>
                    <span class="badge badge-primary badge-sm"><i class="fas fa-credit-card mr-1"></i> Auto-charge</span>
                  <% else %>
                    <span class="badge badge-outline badge-sm"><i class="fas fa-envelope mr-1"></i> Send Invoice</span>
                  <% end %>
                </td>
                <td><%= ri.billing_day_of_month.ordinalize %></td>
                <td>
                  <% last_invoice = ri.invoices.select { |inv| inv.status.in?(%w[sent paid]) }.max_by(&:created_at) %>
                  <% if last_invoice %>
                    <span class="font-medium"><%= number_to_currency(last_invoice.total) %></span>
                  <% else %>
                    <span class="opacity-40">—</span>
                  <% end %>
                </td>
                <td>
                  <%
                    default_markup = Setting[:default_markup_percentage]&.to_f || 30.0
                    infra_floor = 0
                    usage_to_date = 0
                    app_ids = []

                    ri.client.app_assignments.each do |aa|
                      next unless aa.app.included?
                      markup = aa.markup_percentage || ri.client.try(:markup_percentage) || default_markup
                      app_ids << aa.app_id

                      aa.app.render_services.reject(&:suspended?).each do |rs|
                        base = rs.monthly_price
                        infra_floor += (base * (1 + markup / 100.0)).round(2) if base > 0
                      end
                    end

                    if app_ids.any?
                      raw_usage = ApiUsageLog.where(app_id: app_ids)
                                             .where("created_at >= ?", Date.current.beginning_of_month)
                                             .sum(:estimated_cost)
                      if raw_usage > 0
                        avg_markup = ri.client.app_assignments.average(:markup_percentage)&.to_f || ri.client.try(:markup_percentage)&.to_f || default_markup
                        usage_to_date = (raw_usage * (1 + avg_markup / 100.0)).round(2)
                      end
                    end

                    est_total = infra_floor + usage_to_date
                  %>
                  <% if est_total > 0 %>
                    <span class="font-medium">~<%= number_to_currency(est_total) %>+</span>
                    <% if usage_to_date > 0 %>
                      <br><span class="text-xs opacity-50">incl. <%= number_to_currency(usage_to_date) %> usage</span>
                    <% end %>
                  <% else %>
                    <span class="opacity-40">—</span>
                  <% end %>
                </td>
                <td>
                  <% if ri.next_billing_date %>
                    <span class="<%= ri.next_billing_date <= Date.current ? 'text-warning font-medium' : '' %>">
                      <%= local_time(ri.next_billing_date) %>
                    </span>
                  <% else %>
                    <span class="opacity-40">--</span>
                  <% end %>
                </td>
                <td>
                  <% if ri.last_billed_date %>
                    <%= local_time(ri.last_billed_date) %>
                  <% else %>
                    <span class="opacity-40">Never</span>
                  <% end %>
                </td>
                <td><%= ri.invoices.count %></td>
                <td>
                  <%= link_to admin_recurring_invoice_path(ri), class: "btn btn-ghost btn-xs" do %>
                    <i class="fas fa-eye"></i>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <%# Pending Draft Invoices Section %>
  <% draft_invoices = @recurring_invoices.flat_map { |ri| ri.invoices.select { |inv| inv.status == "draft" } } %>
  <% if draft_invoices.any? %>
    <div class="card bg-base-100 shadow">
      <div class="card-body">
        <h3 class="card-title text-base mb-4">
          <i class="fas fa-file-invoice mr-2"></i>
          Pending Draft Invoices
          <span class="badge badge-ghost ml-2"><%= draft_invoices.size %></span>
        </h3>
        <div class="overflow-x-auto">
          <table class="table">
            <thead>
              <tr>
                <th>Client</th>
                <th>Period</th>
                <th>Line Items</th>
                <th>Total</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% draft_invoices.each do |invoice| %>
                <tr>
                  <td class="font-medium"><%= invoice.client.name %></td>
                  <td class="text-sm">
                    <% if invoice.period_start && invoice.period_end %>
                      <%= local_time(invoice.period_start, "month-day") %> - <%= local_time(invoice.period_end, "short-date") %>
                    <% else %>
                      —
                    <% end %>
                  </td>
                  <td><%= invoice.line_items.count %></td>
                  <td class="font-medium"><%= number_to_currency(invoice.total) %></td>
                  <td>
                    <div class="flex gap-1">
                      <%= link_to admin_invoice_path(invoice), class: "btn btn-ghost btn-xs", title: "Review" do %>
                        <i class="fas fa-eye"></i>
                      <% end %>
                      <%= link_to preview_send_admin_invoice_path(invoice), class: "btn btn-primary btn-xs", title: "Send to Stripe" do %>
                        <i class="fas fa-paper-plane"></i>
                      <% end %>
                      <%= button_to admin_invoice_path(invoice), method: :delete, class: "btn btn-ghost btn-xs text-error", title: "Delete", data: { turbo_confirm: "Delete this draft invoice?" } do %>
                        <i class="fas fa-trash"></i>
                      <% end %>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  <% end %>
<% end %>
