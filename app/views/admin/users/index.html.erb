<div class="space-y-6">
  <h1 class="text-2xl font-bold">Whitelisted Emails</h1>
  <p class="text-sm opacity-70">Only these email addresses can sign in with Google OAuth.</p>

  <!-- Add email form -->
  <div class="card bg-base-100 shadow">
    <div class="card-body">
      <h2 class="card-title text-lg">Add Email</h2>
      <%= form_with model: @allowed_email, url: admin_users_path, class: "flex items-end gap-3" do |f| %>
        <div class="form-control flex-1">
          <%= f.label :email, class: "label" do %>
            <span class="label-text">Email address</span>
          <% end %>
          <%= f.email_field :email, placeholder: "user@example.com", class: "input input-bordered w-full", required: true %>
          <% if @allowed_email.errors[:email].any? %>
            <label class="label">
              <span class="label-text-alt text-error"><%= @allowed_email.errors[:email].first %></span>
            </label>
          <% end %>
        </div>
        <%= f.submit "Add to Whitelist", class: "btn btn-primary" %>
      <% end %>
    </div>
  </div>

  <!-- Allowed emails list -->
  <div class="card bg-base-100 shadow">
    <div class="card-body">
      <h2 class="card-title text-lg">
        Allowed Emails
        <span class="badge badge-neutral"><%= @allowed_emails.size %></span>
      </h2>

      <% if @allowed_emails.any? %>
        <div class="overflow-x-auto">
          <table class="table">
            <thead>
              <tr>
                <th>Email</th>
                <th>Added</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <% @allowed_emails.each do |allowed| %>
                <tr class="hover">
                  <td class="font-mono"><%= allowed.email %></td>
                  <td class="text-sm opacity-70"><%= allowed.created_at.strftime("%b %d, %Y") %></td>
                  <td class="text-right">
                    <%= button_to admin_user_path(allowed), method: :delete,
                          class: "btn btn-ghost btn-sm text-error",
                          form: { data: { turbo_confirm: "Remove #{allowed.email} from the whitelist?" } } do %>
                      <i class="fas fa-trash-alt"></i> Remove
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="text-center py-8 opacity-50">
          <i class="fas fa-envelope text-4xl mb-2"></i>
          <p>No emails whitelisted yet. Add one above to get started.</p>
        </div>
      <% end %>
    </div>
  </div>
</div>
