<div class="flex justify-between items-center mb-6">
  <div>
    <h2 class="text-2xl font-bold">Agent Alerts</h2>
    <p class="text-sm opacity-60"><%= @open_count %> open, <%= @unresolved_count %> unresolved</p>
  </div>
</div>

<!-- Filters -->
<div class="card bg-base-100 shadow mb-6">
  <div class="card-body py-3">
    <%= form_with(url: admin_agent_alerts_path, method: :get, data: { controller: "filter", filter_target: "form", action: "input->filter#submit" }) do |f| %>
      <div class="flex flex-wrap gap-4 items-end">
        <div class="form-control">
          <label class="label"><span class="label-text">Status</span></label>
          <%= f.select :status, AgentAlert::STATUSES.map { |s| [s.capitalize, s] }, { include_blank: "All" }, class: "select select-bordered select-sm", data: { action: "change->filter#submit" } %>
        </div>
        <div class="form-control">
          <label class="label"><span class="label-text">Severity</span></label>
          <%= f.select :severity, AgentAlert::SEVERITIES.map { |s| [s.capitalize, s] }, { include_blank: "All" }, class: "select select-bordered select-sm", data: { action: "change->filter#submit" } %>
        </div>
        <div class="form-control">
          <label class="label"><span class="label-text">Type</span></label>
          <%= f.select :alert_type, AgentAlert::ALERT_TYPES.map { |t| [t.titleize, t] }, { include_blank: "All" }, class: "select select-bordered select-sm", data: { action: "change->filter#submit" } %>
        </div>
        <div>
          <%= f.submit "Filter", class: "btn btn-primary btn-sm" %>
          <%= link_to "Clear", admin_agent_alerts_path, class: "btn btn-ghost btn-sm" %>
        </div>
      </div>
    <% end %>
  </div>
</div>

<!-- Alerts Table -->
<div class="overflow-x-auto bg-base-100 rounded-box shadow">
  <table class="table">
    <thead>
      <tr>
        <th>Severity</th>
        <th>Title</th>
        <th>Type</th>
        <th>Agent</th>
        <th>Status</th>
        <th>Created</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @alerts.each do |alert| %>
        <tr class="<%= alert.status == 'open' && alert.severity.in?(%w[error critical]) ? 'bg-error/5' : '' %>">
          <td>
            <span class="badge badge-<%= alert.severity_badge_color %> badge-sm"><%= alert.severity %></span>
          </td>
          <td>
            <%= link_to alert.title, admin_agent_alert_path(alert), class: "link link-primary font-medium" %>
            <% if alert.description.present? %>
              <br><span class="text-xs opacity-60"><%= alert.description.truncate(80) %></span>
            <% end %>
          </td>
          <td><span class="badge badge-outline badge-sm"><%= alert.alert_type.titleize %></span></td>
          <td>
            <% if alert.agent %>
              <%= link_to alert.agent.name, admin_agent_path(alert.agent), class: "link text-sm" %>
            <% else %>
              <span class="opacity-60">—</span>
            <% end %>
          </td>
          <td><span class="badge badge-<%= alert.status == 'open' ? 'warning' : 'ghost' %> badge-sm"><%= alert.status %></span></td>
          <td class="text-sm"><%= time_ago_in_words(alert.created_at) %> ago</td>
          <td class="flex gap-1">
            <% if alert.status == "open" %>
              <%= button_to acknowledge_admin_agent_alert_path(alert), method: :post, class: "btn btn-ghost btn-xs", title: "Acknowledge" do %>
                <i class="fas fa-eye"></i>
              <% end %>
            <% end %>
            <% if alert.status.in?(%w[open acknowledged]) %>
              <%= button_to resolve_admin_agent_alert_path(alert), method: :post, class: "btn btn-ghost btn-xs text-success", title: "Resolve" do %>
                <i class="fas fa-check"></i>
              <% end %>
              <%= button_to dismiss_admin_agent_alert_path(alert), method: :post, class: "btn btn-ghost btn-xs text-error", title: "Dismiss" do %>
                <i class="fas fa-times"></i>
              <% end %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <% if @alerts.empty? %>
    <div class="text-center py-8 opacity-60">
      <i class="fas fa-check-circle text-4xl text-success mb-2"></i>
      <p>No alerts. Everything is running smoothly.</p>
    </div>
  <% end %>
</div>
