<div class="flex justify-between items-center mb-6">
  <h2 class="text-2xl font-bold">Agent Executions</h2>
</div>

<!-- Filters -->
<div class="card bg-base-100 shadow mb-6">
  <div class="card-body py-3">
    <%= form_with(url: admin_agent_executions_path, method: :get, data: { controller: "filter", filter_target: "form", action: "input->filter#submit" }) do |f| %>
      <div class="flex flex-wrap gap-4 items-end">
        <div class="form-control">
          <label class="label"><span class="label-text">Status</span></label>
          <%= f.select :status, AgentExecution::STATUSES.map { |s| [s.titleize, s] }, { include_blank: "All" }, class: "select select-bordered select-sm", data: { action: "change->filter#submit" } %>
        </div>
        <div class="form-control">
          <label class="label"><span class="label-text">Mode</span></label>
          <%= f.select :mode, [["Test", "test"], ["Live", "live"]], { include_blank: "All" }, class: "select select-bordered select-sm", data: { action: "change->filter#submit" } %>
        </div>
        <div>
          <%= f.submit "Filter", class: "btn btn-primary btn-sm" %>
          <%= link_to "Clear", admin_agent_executions_path, class: "btn btn-ghost btn-sm" %>
        </div>
      </div>
    <% end %>
  </div>
</div>

<!-- Executions Table -->
<div class="overflow-x-auto bg-base-100 rounded-box shadow">
  <table class="table">
    <thead>
      <tr>
        <th>ID</th>
        <th>Agent</th>
        <th>Status</th>
        <th>Mode</th>
        <th>Steps</th>
        <th>Tokens</th>
        <th>Cost</th>
        <th>Duration</th>
        <th>Started</th>
      </tr>
    </thead>
    <tbody>
      <% @executions.each do |exec| %>
        <tr>
          <td><%= link_to "##{exec.id}", admin_agent_execution_path(exec), class: "link link-primary" %></td>
          <td><%= link_to exec.agent.name, admin_agent_path(exec.agent), class: "link" %></td>
          <td><span class="badge badge-<%= exec.status_badge_color %> badge-sm"><%= exec.status %></span></td>
          <td>
            <span class="badge badge-<%= exec.mode == 'test' ? 'warning' : 'success' %> badge-outline badge-sm">
              <%= exec.mode %>
            </span>
          </td>
          <td><%= exec.steps.count %></td>
          <td><%= number_with_delimiter(exec.total_tokens) %></td>
          <td>$<%= number_with_precision(exec.total_cost, precision: 4) %></td>
          <td><%= exec.duration_display %></td>
          <td class="text-sm"><%= local_time(exec.created_at, "compact-datetime") %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <% if @executions.empty? %>
    <div class="text-center py-8 opacity-60">
      <p>No executions yet.</p>
    </div>
  <% end %>
</div>
