<!DOCTYPE html>
<html>
<head>
  <title><%= @bid&.title || "Document" %></title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    @media print {
      body { margin: 0; padding: 20px; }
      .no-print { display: none !important; }
    }
  </style>
</head>
<body class="bg-white p-8 max-w-4xl mx-auto">
  <div class="no-print mb-4 flex gap-2">
    <button onclick="window.print()" class="bg-blue-600 text-white px-4 py-2 rounded">
      Download PDF (Print)
    </button>
    <a href="javascript:history.back()" class="bg-gray-300 text-gray-700 px-4 py-2 rounded">Back</a>
  </div>
  <%= yield %>
</body>
</html>
