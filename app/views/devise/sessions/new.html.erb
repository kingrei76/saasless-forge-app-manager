<% content_for :header do %>
  Sign In
<% end %>

<div class="max-w-md mx-auto mt-8 bg-white rounded-lg shadow-md p-8">
  <h2 class="text-2xl font-bold text-center mb-6">Welcome to SaaSless Forge</h2>

  <% if ENV["GOOGLE_CLIENT_ID"].present? %>
    <% google_oauth_url = "https://accounts.google.com/o/oauth2/v2/auth?client_id=#{ENV['GOOGLE_CLIENT_ID']}&redirect_uri=#{CGI.escape(auth_google_callback_url)}&response_type=code&scope=email+profile" %>
    <%= link_to google_oauth_url, class: "w-full flex items-center justify-center gap-2 rounded border border-gray-300 bg-white py-2 px-4 text-gray-700 font-medium hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-indigo-400" do %>
      <svg class="w-5 h-5" viewBox="0 0 24 24"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/></svg>
      Sign in with Google
    <% end %>
  <% else %>
    <p class="text-center text-gray-500">Google sign-in is not configured. Please set GOOGLE_CLIENT_ID.</p>
  <% end %>

  <% if ENV["SKIP_AUTH"] == "true" %>
    <div class="divider my-4 text-sm text-gray-400">OR</div>
    <%= link_to dev_login_path, class: "w-full flex items-center justify-center gap-2 rounded bg-gray-800 py-2 px-4 text-white font-medium hover:bg-gray-700" do %>
      Dev Login (Auto-admin)
    <% end %>
  <% end %>
</div>
